<UserControl x:Class="BlueMeter.Controls.BatteryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BlueMeter.Controls"
             xmlns:models="clr-namespace:BlueMeter.Models"
             x:Name="Root"
             Width="120"
             Height="8"
             IsHitTestVisible="False"
             Focusable="False">
    <Grid>
        <!-- 轨道用强填充色并降透明度，在 Mica / 卡片背景上都留得住形。 -->
        <Border CornerRadius="4"
                Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                Opacity="0.55" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FillColumn" Width="*" />
                <ColumnDefinition x:Name="RemainderColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左端圆角由填充自身提供（右端在未满 100% 时是直角，切断处不误读）。 -->
            <Border x:Name="Fill" Grid.Column="0" CornerRadius="4,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, ElementName=Root}" Value="{x:Static models:BatteryLevel.Caution}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, ElementName=Root}" Value="{x:Static models:BatteryLevel.Critical}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Grid>
</UserControl>
