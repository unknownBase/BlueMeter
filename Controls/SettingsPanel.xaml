<UserControl x:Class="BlueMeter.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- 设置面板：内联卡片，展开时压缩列表高度，不改变窗口尺寸 -->
    <Border MaxHeight="320"
            Margin="32,0,32,12"
            Padding="20,16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="设置" />
                    <ui:Button HorizontalAlignment="Right"
                               Command="{Binding ToggleSettingsCommand}"
                               Content="完成" />
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="188" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="刷新间隔" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="10 秒 – 24 小时，修改立即生效" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBox Width="64"
                                 KeyDown="OnRefreshIntervalKeyDown"
                                 LostFocus="OnRefreshIntervalLostFocus"
                                 Text="{Binding Settings.RefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right"
                                 VerticalContentAlignment="Center" />
                        <ComboBox Width="88"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding Settings.UnitOptions}"
                                  SelectedItem="{Binding Settings.SelectedUnit, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="低电量阈值" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="5–50%，读取成功后立即生效" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Settings.ThresholdOptions}"
                              SelectedItem="{Binding Settings.SelectedThreshold, Mode=TwoWay}" />
                </Grid>

                <ui:ToggleSwitch Margin="0,14,0,0"
                                 Content="低电量时弹出托盘气泡"
                                 IsChecked="{Binding Settings.LowBatteryNotificationsEnabled, Mode=TwoWay}" />

                <ui:ToggleSwitch Margin="0,10,0,0"
                                 Content="在任务栏右键菜单显示设备电量（最多 3 个）"
                                 IsChecked="{Binding Settings.ShowBatteryInTrayMenu, Mode=TwoWay}" />

                <ui:ToggleSwitch Margin="0,10,0,0"
                                 Content="订阅 BLE 电量通知（关闭后改为轮询）"
                                 IsChecked="{Binding Settings.UseGattNotifications, Mode=TwoWay}" />

                <ui:ToggleSwitch Margin="0,10,0,0"
                                 Content="在列表中显示不支持电量的设备"
                                 IsChecked="{Binding Settings.ShowUnsupportedDevices, Mode=TwoWay}" />

                <ui:ToggleSwitch Margin="0,10,0,0"
                                 Content="开机时自动启动"
                                 IsChecked="{Binding Settings.RunAtStartup, Mode=TwoWay}" />

                <ui:ToggleSwitch Margin="0,10,0,0"
                                 Content="启动时最小化到托盘（下次启动生效）"
                                 IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Command="{Binding OpenLogDirectoryCommand}"
                               Content="打开日志目录" />
                    <ui:Button Command="{Binding HideToTrayCommand}" Content="隐藏到托盘" />
                </StackPanel>

                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Settings.SettingsPathText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
