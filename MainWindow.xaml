<ui:FluentWindow x:Class="BlueMeter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="BlueMeter"
                 Width="780"
                 Height="600"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/BlueMeter.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="BlueMeter"
                     Icon="pack://application:,,,/Assets/BlueMeter.ico" />

        <Grid Grid.Row="1" Margin="32,24,32,32">
            <Border MaxWidth="560"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="BlueMeter 已在托盘运行" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="关闭此窗口只会隐藏到系统托盘。右键托盘图标可显示窗口或退出。"
                               TextWrapping="Wrap" />

                    <Border Height="1"
                            Margin="0,22"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="当前版本已完成工程配置、托盘、单实例、窗口生命周期、设置与日志骨架。设备扫描与电量读取将在后续版本接入。"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Click="OnHideToTrayClick"
                                   Content="隐藏到托盘" />
                        <ui:Button Click="OnOpenLogDirectoryClick"
                                   Content="打开日志目录" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
