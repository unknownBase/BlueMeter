<ui:FluentWindow x:Class="BlueMeter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="BlueMeter"
                 Width="780"
                 Height="640"
                 MinWidth="560"
                 MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/BlueMeter.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="BlueMeter"
                     Icon="pack://application:,,,/Assets/BlueMeter.ico" />

        <Grid Grid.Row="1" Margin="32,20,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="设备电量" />
                <TextBlock x:Name="GlobalStatusText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="正在启动设备刷新…"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="等待蓝牙或 2.4G 设备扫描"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList" Margin="18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding MetaText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="18,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding BatteryText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyStateText"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="尚未发现蓝牙或 2.4G 设备"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 设置面板：M4 完整设置页之前的可用形态，覆盖在列表上方，收起时不影响列表布局。 -->
            <Border x:Name="SettingsPanel"
                    Grid.Row="1"
                    Margin="0,18"
                    Padding="20,16"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="设置" />
                        <ui:Button HorizontalAlignment="Right"
                                   Click="OnCloseSettingsClick"
                                   Content="完成" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="188" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="刷新间隔" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="10 秒 – 24 小时，修改立即生效" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBox x:Name="RefreshIntervalInput"
                                     Width="64"
                                     KeyDown="OnRefreshIntervalKeyDown"
                                     LostFocus="OnRefreshIntervalEdited"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center" />
                            <ComboBox x:Name="RefreshIntervalUnitBox"
                                      Width="88"
                                      Margin="8,0,0,0"
                                      SelectionChanged="OnRefreshIntervalUnitChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="低电量阈值" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="5–50%，读取成功后立即生效" />
                        </StackPanel>
                        <ComboBox x:Name="LowThresholdBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnLowThresholdChanged" />
                    </Grid>

                    <ui:ToggleSwitch x:Name="NotificationsSwitch"
                                     Margin="0,14,0,0"
                                     Checked="OnNotificationsToggled"
                                     Unchecked="OnNotificationsToggled"
                                     Content="低电量时弹出托盘气泡" />

                    <ui:ToggleSwitch x:Name="GattSwitch"
                                     Margin="0,10,0,0"
                                     Checked="OnGattToggled"
                                     Unchecked="OnGattToggled"
                                     Content="订阅 BLE 电量通知（关闭后改为轮询）" />

                    <ui:ToggleSwitch x:Name="ShowUnsupportedSwitch"
                                     Margin="0,10,0,0"
                                     Checked="OnShowUnsupportedToggled"
                                     Unchecked="OnShowUnsupportedToggled"
                                     Content="在列表中显示不支持电量的设备" />

                    <ui:ToggleSwitch x:Name="RunAtStartupSwitch"
                                     Margin="0,10,0,0"
                                     Checked="OnRunAtStartupToggled"
                                     Unchecked="OnRunAtStartupToggled"
                                     Content="开机时自动启动" />

                    <ui:ToggleSwitch x:Name="StartMinimizedSwitch"
                                     Margin="0,10,0,0"
                                     Checked="OnStartMinimizedToggled"
                                     Unchecked="OnStartMinimizedToggled"
                                     Content="启动时最小化到托盘（下次启动生效）" />

                    <TextBlock x:Name="SettingsPathText"
                               Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ui:Button x:Name="RefreshButton"
                           Margin="0,0,8,0"
                           Click="OnRefreshClick"
                           Content="立即刷新" />
                <ui:Button Margin="0,0,8,0"
                           Click="OnHideToTrayClick"
                           Content="隐藏到托盘" />
                <ui:Button Margin="0,0,8,0"
                           Click="OnOpenLogDirectoryClick"
                           Content="打开日志目录" />
                <ui:Button Click="OnOpenSettingsClick"
                           Content="设置" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
