<ui:FluentWindow x:Class="BlueMeter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="BlueMeter"
                 Width="780"
                 Height="640"
                 MinWidth="560"
                 MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/BlueMeter.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="BlueMeter"
                     Icon="pack://application:,,,/Assets/BlueMeter.ico" />

        <Grid Grid.Row="1" Margin="32,20,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="设备电量" />
                <TextBlock x:Name="GlobalStatusText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="正在启动设备刷新…"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="等待已配对设备扫描"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList" Margin="18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding MetaText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="18,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding BatteryText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyStateText"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="尚未发现已配对设备"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ui:Button x:Name="RefreshButton"
                           Margin="0,0,8,0"
                           Click="OnRefreshClick"
                           Content="立即刷新" />
                <ui:Button Margin="0,0,8,0"
                           Click="OnHideToTrayClick"
                           Content="隐藏到托盘" />
                <ui:Button Click="OnOpenLogDirectoryClick"
                           Content="打开日志目录" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
